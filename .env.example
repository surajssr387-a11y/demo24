# ==============================================================================
# RAZORPAY LIVE & TEST PAYMENT CREDENTIALS SETUP GUIDE
# ==============================================================================
# 1. Razorpay Dashboard me login karein: https://dashboard.razorpay.com
# 2. Left sidebar me "Account & Settings" -> "API Keys" par click karein.
# 3. Agar Live chalana hai: Top me "Live Mode" toggle on karein aur "Generate Key" dabayein.
#    - Key ID start hogi: rzp_live_...
#    - Key Secret: ek baar dikhega, use copy karke yahan paste karein.
# 4. Agar Test chalana hai: Top me "Test Mode" toggle rakhein.
#    - Key ID start hogi: rzp_test_...
# ==============================================================================

# YAHAN APNI RAZORPAY KEY ID DALEIN (Live me rzp_live_..., Test me rzp_test_...):
RAZORPAY_KEY_ID="rzp_test_TmGhxLupa7Bm8z"

# YAHAN APNA RAZORPAY KEY SECRET DALEIN (Dashboard se mila hua secret key):
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# ==============================================================================
# RAZORPAY WEBHOOK SETUP GUIDE
# ==============================================================================
# 1. Razorpay Dashboard -> "Account & Settings" -> "Webhooks" -> "Add New Webhook"
# 2. Webhook URL me apni domain ka URL dalein:
#    Format: https://<AAPKI_WEBSITE_DOMAIN>/api/payment/webhook
# 3. Secret field me ek koi bhi strong password/secret banakar dalein (jaise: my_dance_studio_webhook_secret_2026)
#    Aur wahi secret yahan RAZORPAY_WEBHOOK_SECRET me paste karein:
# 4. Active Events me yeh 3 events select karein:
#    - payment.captured  (Payment confirm hone par)
#    - order.paid        (Order pay hone par)
#    - payment.failed    (Payment fail hone par)
# ==============================================================================
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

