# ==============================================================================
# RAMY'S DANCE STUDIO - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' for local development or set these variables in
#    your deployment dashboard (Vercel, Render, Railway, Cloud Run).
# 2. Never commit your actual '.env' file containing real secrets to Git.
# ==============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV="production"
APP_URL="https://yourdomain.com"

# ==============================================================================
# RAZORPAY PAYMENT GATEWAY CREDENTIALS
# ==============================================================================
# Generated from Razorpay Dashboard: https://dashboard.razorpay.com
# Navigation: Account & Settings -> API Keys -> Generate Key
#
# For Live Payments (starts with rzp_live_):
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_live_secret_key"

# For Test/Sandbox mode during testing (starts with rzp_test_):
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="your_razorpay_test_secret_key"

# ==============================================================================
# RAZORPAY WEBHOOK SECRET
# ==============================================================================
# Navigation: Razorpay Dashboard -> Account & Settings -> Webhooks -> Add Webhook
# Webhook URL: https://yourdomain.com/api/payment/webhook
# Active Events:
#   - payment.captured
#   - order.paid
#   - payment.failed
RAZORPAY_WEBHOOK_SECRET="your_secure_webhook_secret_phrase"

# ==============================================================================
# STUDIO ADMIN DASHBOARD ACCESS
# ==============================================================================
# Secret key used for authenticating privileged administrative actions (/api/payment/admin/*)
ADMIN_SECRET="your_secure_admin_passphrase"

# ==============================================================================
# OPTIONAL AI / THIRD-PARTY SERVICES
# ==============================================================================
GEMINI_API_KEY="your_optional_gemini_api_key"


